# --- AI (Google Gemini) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
MODEL_DESCRIPTION=an Indian woman in her late 20s

# --- Shopify store
SHOPIFY_SHOP=your-store.myshopify.com
# Option A: Admin API access token (starts with shpat_) from a custom app
SHOPIFY_ACCESS_TOKEN=
# Option B: Dev Dashboard app (client credentials) - leave token empty and fill these
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10

# --- Store defaults
STORE_VENDOR=KOSHAA
DEFAULT_PRODUCT_TYPE=Printed Nighty
PORT=5050
